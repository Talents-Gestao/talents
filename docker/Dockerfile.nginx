# Nginx de produção — reutiliza a imagem PHP já buildada (evita recompilar extensões no Coolify).
# O contexto nomeado "app" vem de additional_contexts: service:app no docker-compose.prod.yml.
# Build: docker compose -f docker-compose.prod.yml build nginx

FROM nginx:1.27-alpine

COPY docker/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=app /var/www/html/public /var/www/html/public

RUN rm -f /var/www/html/public/storage \
    && ln -s /var/www/html/storage/app/public /var/www/html/public/storage

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]

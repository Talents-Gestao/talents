# Legado. Coolify e docker-compose.prod.yml usam docker/Dockerfile (target nginx)
# para não recompilar o PHP. Este arquivo fica só para builds manuais pontuais.
# Build: docker compose -f docker-compose.prod.yml build nginx

FROM nginx:1.27-alpine

COPY docker/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=app /var/www/html/public /var/www/html/public

RUN rm -f /var/www/html/public/storage \
    && ln -s /var/www/html/storage/app/public /var/www/html/public/storage

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
